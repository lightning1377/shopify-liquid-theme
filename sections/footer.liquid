<footer class='site-footer{% if template.name == 'index' %} site-footer--gateway{% endif %}'>
  <div class='page-width'>
    {%- unless template.name == 'index' -%}
      <div class='footer-top-grid'>
        <!-- Col 1: Brand Info & Socials -->
        <div class='footer-col'>
          {%- assign footer_brand_name = section.settings.brand_text | default: 'KAVRA' -%}
          {%- if footer_brand_name == blank -%}
            {%- assign footer_brand_name = 'KAVRA' -%}
          {%- endif -%}
          <a class='brand-logo footer-brand-title' href='{{ routes.root_url }}'>
            {{ footer_brand_name }}
          </a>
          <p class='footer-brand-desc'>
            {%- if section.settings.brand_desc != blank -%}
              {{ section.settings.brand_desc }}
            {%- else -%}
              {{ 'sections.footer.brand_description' | t }}
            {%- endif -%}
          </p>
          <div
            class='footer-social-links'
            aria-label='{{ 'general.accessibility.social_media' | t }}'
          >
            {%- if settings.social_instagram_link != blank -%}
              <a
                href='{{ settings.social_instagram_link }}'
                target='_blank'
                rel='noopener'
                aria-label='Instagram'
              >
                <svg
                  width='20'
                  height='20'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a
                href='{{ settings.social_facebook_link }}'
                target='_blank'
                rel='noopener'
                aria-label='Facebook'
              >
                <svg
                  width='20'
                  height='20'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                >
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <a
                href='{{ settings.social_twitter_link }}'
                target='_blank'
                rel='noopener'
                aria-label='X / Twitter'
              >
                <svg
                  width='20'
                  height='20'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                >
                  <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
                  <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a
                href='{{ settings.social_youtube_link }}'
                target='_blank'
                rel='noopener'
                aria-label='YouTube'
              >
                <svg
                  width='20'
                  height='20'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                >
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>

        <!-- Col 2: Corporate Links -->
        <div class='footer-col'>
          <h3 class='footer-col-title'>
            {%- if section.settings.col2_title != blank -%}
              {{ section.settings.col2_title }}
            {%- else -%}
              {{ 'sections.footer.corporate' | t }}
            {%- endif -%}
          </h3>
          <ul class='footer-nav-list'>
            <li>
              <a href='{{ routes.root_url }}pages/hakkimizda'>{{ 'sections.footer.about' | t }}</a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/surdurulebilirlik'>
                {{- 'sections.footer.sustainability' | t -}}
              </a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/kavra-club'>{{ 'content.footer.club' | t }}</a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/magazalar'>{{ 'sections.footer.stores' | t }}</a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/kariyer'>{{ 'sections.footer.careers' | t }}</a>
            </li>
          </ul>
        </div>

        <!-- Col 3: Customer Care & Help -->
        <div class='footer-col'>
          <h3 class='footer-col-title'>
            {%- if section.settings.col3_title != blank -%}
              {{ section.settings.col3_title }}
            {%- else -%}
              {{ 'sections.footer.help' | t }}
            {%- endif -%}
          </h3>
          <ul class='footer-nav-list'>
            <li>
              <a href='{{ routes.root_url }}pages/siparis-takibi'>
                {{- 'sections.footer.order_tracking' | t -}}
              </a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/kargo-teslimat'>
                {{- 'sections.footer.shipping' | t -}}
              </a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/iade-degisim'>
                {{- 'sections.footer.returns' | t -}}
              </a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/sss'>{{ 'sections.footer.faq' | t }}</a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/beden-tablosu'>
                {{- 'sections.footer.size_guide' | t -}}
              </a>
            </li>
            <li>
              <a href='{{ routes.root_url }}pages/iletisim'>{{ 'sections.footer.contact' | t }}</a>
            </li>
          </ul>
        </div>

        <!-- Col 4: Top Categories -->
        <div class='footer-col'>
          <h3 class='footer-col-title'>
            {%- if section.settings.col4_title != blank -%}
              {{ section.settings.col4_title }}
            {%- else -%}
              {{ 'sections.footer.collections' | t }}
            {%- endif -%}
          </h3>
          {%- assign is_kadin_footer = false -%}
          {%- if collection.handle contains 'kadin' -%}
            {%- assign is_kadin_footer = true -%}
          {%- endif -%}
          {%- capture footer_base_coll_url -%}
            {%- if is_kadin_footer -%}
              {% render 'audience-collection-url', gender: 'kadin' %}
            {%- else -%}
              {% render 'audience-collection-url', gender: 'erkek' %}
            {%- endif -%}
          {%- endcapture -%}
          {%- assign footer_base_coll_url = footer_base_coll_url | strip -%}
          <ul class='footer-nav-list'>
            <li>
              <a href='{{ footer_base_coll_url }}/deri-ceket'>
                {%- if is_kadin_footer -%}
                  {{
                    'content.collection.women_jackets'
                    | t
                    | default: 'sections.footer.mens_leather_jackets'
                    | t
                  }}
                {%- else -%}
                  {{ 'sections.footer.mens_leather_jackets' | t }}
                {%- endif -%}
              </a>
            </li>
            <li>
              <a href='{{ footer_base_coll_url }}/ayakkabi'>
                {%- if is_kadin_footer -%}
                  {{
                    'content.collection.women_shoes'
                    | t
                    | default: 'sections.footer.mens_shoes'
                    | t
                  }}
                {%- else -%}
                  {{ 'sections.footer.mens_shoes' | t }}
                {%- endif -%}
              </a>
            </li>
            <li>
              <a href='{{ footer_base_coll_url }}/canta'>
                {{- 'sections.footer.leather_bags' | t -}}
              </a>
            </li>
            <li>
              <a href='{{ footer_base_coll_url }}/cuzdan'>
                {{- 'sections.footer.wallets' | t -}}
              </a>
            </li>
            <li>
              <a href='{{ footer_base_coll_url }}/sepette-indirimli'>
                {{- 'sections.footer.outlet' | t -}}
              </a>
            </li>
          </ul>
        </div>
      </div>
    {%- endunless -%}

    <!-- Sub-footer Bar -->
    <div class='footer-bottom-bar'>
      <div>
        © {{ 'now' | date: '%Y' }}
        {{ shop.name | default: 'KAVRA' }}. {{ 'sections.footer.copyright' | t }}
      </div>
      <div>{{ 'sections.footer.location' | t }}</div>
      <div>
        {{ 'sections.footer.legal' | t }} &nbsp;&middot;&nbsp;
        {{ 'sections.footer.privacy' | t }} &nbsp;&middot;&nbsp;
        {{ 'sections.footer.privacy_notice' | t }}
      </div>
    </div>
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "text",
        "id": "brand_text",
        "label": "Brand Name",
        "default": "KAVRA"
      },
      {
        "type": "textarea",
        "id": "brand_desc",
        "label": "Brand Description"
      },
      {
        "type": "text",
        "id": "col2_title",
        "label": "Column 2 Title"
      },
      {
        "type": "text",
        "id": "col3_title",
        "label": "Column 3 Title"
      },
      {
        "type": "text",
        "id": "col4_title",
        "label": "Column 4 Title"
      }
    ],
    "presets": [
      {
        "name": "Footer"
      }
    ]
  }
{% endschema %}
