{
  "$schema": "https://json.schemastore.org/prettierrc",
  "plugins": ["@shopify/prettier-plugin-liquid"],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "liquidSingleQuote": true,
  "embeddedSingleQuote": true,
  "indentSchema": true,
  "overrides": [
    {
      "files": "*.liquid",
      "options": {
        "parser": "liquid-html"
      }
    },
    {
      "files": "*.json",
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
