<nav class='breadcrumbs-nav page-width' aria-label='{{ 'general.navigation.breadcrumb' | t }}'>
  <a href='{{ routes.root_url }}'>{{ 'general.navigation.home' | t }}</a>
  <span class='breadcrumbs-separator' aria-hidden='true'>/</span>

  {%- if template.name == 'collection' and collection.handle -%}
    {%- if current_tags -%}
      {{ collection.title | link_to: collection.url }}
      <span class='breadcrumbs-separator' aria-hidden='true'>/</span>
      <span class='breadcrumbs-current' aria-current='page'>{{ current_tags | join: ' + ' }}</span>
    {%- else -%}
      <span class='breadcrumbs-current' aria-current='page'>{{ collection.title }}</span>
    {%- endif -%}
  {%- elsif template.name == 'product' -%}
    {%- if collection.url -%}
      {{ collection.title | link_to: collection.url }}
      <span class='breadcrumbs-separator' aria-hidden='true'>/</span>
    {%- else -%}
      {%- assign prod_check = product.title | append: ' ' | append: product.tags | downcase -%}
      {%- if prod_check contains 'kadin'
        or prod_check contains 'kadın'
        or prod_check contains 'women'
      -%}
        <a href='{% render 'audience-collection-url', gender: 'kadin' %}'>
          {{- 'general.navigation.women' | t -}}
        </a>
      {%- else -%}
        <a href='{% render 'audience-collection-url', gender: 'erkek' %}'>
          {{- 'general.navigation.men' | t -}}
        </a>
      {%- endif -%}
      <span class='breadcrumbs-separator' aria-hidden='true'>/</span>
    {%- endif -%}
    <span class='breadcrumbs-current' aria-current='page'>{{ product.title }}</span>
  {%- elsif template.name == 'page' -%}
    <span class='breadcrumbs-current' aria-current='page'>{{ page.title }}</span>
  {%- else -%}
    <span class='breadcrumbs-current' aria-current='page'>{{ page_title }}</span>
  {%- endif -%}
</nav>
