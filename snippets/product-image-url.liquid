{%- comment -%}
  snippets/product-image-url.liquid
  Resolves the image URL for a product:
  1. Returns product.featured_image if uploaded
  2. Otherwise returns the specific curated editorial photography matched by handle or title
  3. Supports primary and secondary detail shot roles
{%- endcomment -%}
{%- liquid
  if product.featured_image != blank
    if image_role == 'secondary' and product.images.size > 1
      echo product.images[1] | image_url: width: 1200
    else
      echo product.featured_image | image_url: width: 1200
    endif
  else
    assign h = product.handle | downcase
    assign t = product.title | downcase

    if image_role == 'secondary'
      if h contains 'loafer' or t contains 'loafer' or h contains 'florence' or t contains 'florence'
        echo 'https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'sneaker' or t contains 'sneaker' or h contains 'roma' or t contains 'roma'
        echo 'https://images.unsplash.com/photo-1533867617858-e7b97e060509?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'ceket' or t contains 'ceket' or h contains 'mont' or t contains 'mont' or h contains 'trenckot' or t contains 'trençkot' or h contains 'jacket' or t contains 'jacket' or h contains 'coat' or t contains 'coat'
        echo 'https://images.unsplash.com/photo-1520975954732-35dd22299614?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'canta' or t contains 'çanta' or h contains 'sirt' or t contains 'sırt' or h contains 'evrak' or t contains 'evrak' or h contains 'bag' or t contains 'bag' or h contains 'backpack' or t contains 'backpack' or h contains 'briefcase' or t contains 'briefcase'
        echo 'https://images.unsplash.com/photo-1622560480605-d83c853bc5c3?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'bot' or t contains 'bot' or h contains 'cizme' or t contains 'çizme' or h contains 'boot' or t contains 'boot'
        echo 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'cuzdan' or t contains 'cüzdan' or h contains 'kartlik' or t contains 'kartlık' or h contains 'wallet' or t contains 'wallet' or h contains 'cardholder' or t contains 'cardholder'
        echo 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=1200&q=80'
      else
        echo 'https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=1200&q=80'
      endif
    else
      if h contains 'asensio' or t contains 'asensio'
        echo 'https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'milano' or t contains 'milano'
        echo 'https://images.unsplash.com/photo-1520975954732-35dd22299614?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'torino' or t contains 'torino'
        echo 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'florence' or t contains 'florence'
        echo 'https://images.unsplash.com/photo-1533867617858-e7b97e060509?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'roma' or t contains 'roma'
        echo 'https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'venezia' or t contains 'venezia'
        echo 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'monaco' or t contains 'monaco'
        echo 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'capri' or t contains 'capri'
        echo 'https://images.unsplash.com/photo-1622560480605-d83c853bc5c3?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'siena' or t contains 'siena'
        echo 'https://images.unsplash.com/photo-1627123424574-724758594e93?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'lucca' or t contains 'lucca'
        echo 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'bellagio' or t contains 'bellagio'
        echo 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'verona' or t contains 'verona'
        echo 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'loafer' or t contains 'loafer'
        echo 'https://images.unsplash.com/photo-1533867617858-e7b97e060509?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'sneaker' or t contains 'sneaker'
        echo 'https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'bot' or t contains 'bot' or h contains 'cizme' or t contains 'çizme' or h contains 'boot' or t contains 'boot'
        echo 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'canta' or t contains 'çanta' or h contains 'sirt' or t contains 'sırt' or h contains 'evrak' or t contains 'evrak' or h contains 'bag' or t contains 'bag' or h contains 'backpack' or t contains 'backpack' or h contains 'briefcase' or t contains 'briefcase'
        echo 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'cuzdan' or t contains 'cüzdan' or h contains 'kartlik' or t contains 'kartlık' or h contains 'wallet' or t contains 'wallet' or h contains 'cardholder' or t contains 'cardholder'
        echo 'https://images.unsplash.com/photo-1627123424574-724758594e93?auto=format&fit=crop&w=1200&q=80'
      elsif h contains 'kadin' or t contains 'kadın' or h contains 'women' or t contains 'women' or product.tags contains 'Kadın' or product.tags contains 'Women'
        echo 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1200&q=80'
      else
        echo 'https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=1200&q=80'
      endif
    endif
  endif
-%}
